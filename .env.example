# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bundle_game_platform?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# --- Auth (JWT) ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="1h"
JWT_REFRESH_TTL="30d"

# --- Game result verification ---
GAME_SECRET="change-me-game-seed-secret"

# --- Points charge (Toss Payments) ---
# 사행성 방지를 위해 게임 참가비는 현금이 아닌 포인트로만 결제됩니다.
# 이 키는 "포인트 충전"에만 쓰이며, 미설정 시 즉시 충전되는 개발용 시뮬레이션으로 동작합니다.
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# --- Delivery tracking (SweetTracker) ---
# 무료 키 발급: https://tracker.sweettracker.co.kr
# 미설정 시 송장번호 등록 후 배송완료 자동 확인이 동작하지 않고, 주최자가 수동으로 처리해야 합니다.
SWEETTRACKER_API_KEY=""

# --- Frontend (Vite) ---
VITE_API_BASE_URL="http://localhost:4000"
